# Inject this into the service process. Values must never be committed or logged.
# This file is documentation, not an automatically loaded configuration file.
ONEAPI_API_KEY=
# Existing TTS / cover credentials remain separate for this release:
VOLCENGINE_TTS_API_KEY=
DASHSCOPE_API_KEY=
# Shared by CLI / daemon / Web; set the same absolute writable path in every process.
# Default: ${XDG_STATE_HOME:-$HOME/.local/state}/stocktalk
# STOCKTALK_STATE_DIR=/absolute/writable/private/stocktalk
