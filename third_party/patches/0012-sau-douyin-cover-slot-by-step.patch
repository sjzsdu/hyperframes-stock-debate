+def pick_cover_for_step(step: str, portrait: str | None,
+                        landscape: str | None) -> tuple[str | None, str]:
+    """抖音封面弹窗改版后有两个槽：按**当前步骤**决定喂哪张图。
+
+    横槽是 4:3、竖槽是 3:4，比例必须对齐。老逻辑固定先点「设置竖封面」再把
+    3:4 竖图塞进第一个上传 input，可弹窗打开时默认停在「设置横封面」，而步骤条
+    在 AI 封面「生成中」期间点不动（实测 click 被吞）——于是竖图进了 4:3 横槽，
+    抖音按 4:3 裁掉上下，封面只剩中间一条（2026-11-07 用户报「抖音封面有瑕疵」）。
+
+    ``step`` 为 "vertical" / "landscape"；其它值表示旧版单槽弹窗（只有竖封面）。
+    """
+    if step == "vertical":
+        return portrait, "竖版封面"
+    if step == "landscape":
+        return landscape, "横版封面"
+    return (portrait or landscape), "竖版封面"
+
