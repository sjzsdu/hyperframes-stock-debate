+def _extract_tag_from_url(url: str) -> str | None:
+    marker = "/releases/tag/"
+    if marker not in url:
+        return None
+    tag = url.split(marker, 1)[1].split("?", 1)[0].split("#", 1)[0]
+    return tag or None
+
+
+def _extract_tag_from_page_title(html_text: str) -> str | None:
+    match = re.search(r"Release\s+(v[0-9][\w.\-]*)", html_text[:5000])
+    return match.group(1) if match else None
+
+
+def build_fallback_release(tag_name: str) -> dict:
+    """按 biliup 固定的 release 资产命名规则拼出下载地址，并用 HEAD 请求确认存在。"""
+    platform_key = _build_platform_key()
+    patterns = RELEASE_ASSET_PATTERNS.get(platform_key)
+    if not patterns:
+        raise RuntimeError(f"Unsupported biliup platform: {platform_key}")
+
+    candidates = [
+        f"{prefix}-{tag_name}-{suffix}"
+        for suffix in patterns
+        for prefix in ("biliupR", "biliup")
+    ]
+    last_error = ""
+    for asset_name in candidates:
+        asset_url = f"https://github.com/biliup/biliup/releases/download/{tag_name}/{asset_name}"
+        try:
+            probe = requests.head(
+                asset_url,
+                headers={"User-Agent": "social-auto-upload"},
+                timeout=30,
+                allow_redirects=True,
+            )
+            if probe.status_code < 400:
+                return {
+                    "tag_name": tag_name,
+                    "asset_name": asset_name,
+                    "asset_url": asset_url,
+                }
+            last_error = f"HTTP {probe.status_code}"
+        except requests.RequestException as exc:
+            last_error = str(exc)
+    raise RuntimeError(
+        f"No downloadable biliup asset for {platform_key} at {tag_name}: {last_error}"
+    )
+
+
+def fetch_release_via_web_fallback() -> dict:
+    """请求 releases/latest 页面（302 重定向携带最新 tag）绕过 GitHub API 限流。"""
+    response = requests.get(
+        GITHUB_RELEASES_PAGE,
+        headers={"User-Agent": "social-auto-upload"},
+        timeout=30,
+        allow_redirects=True,
+    )
+    response.raise_for_status()
+    tag_name = _extract_tag_from_url(str(response.url)) or _extract_tag_from_page_title(response.text)
+    if not tag_name:
+        raise RuntimeError("Unable to resolve latest biliup release tag from GitHub web page")
+    return build_fallback_release(tag_name)
+
+
