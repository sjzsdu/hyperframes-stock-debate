<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>成片审查 · {{ stock_name }}（{{ stock_code }}）</title>
<style>
  /* 发布前的人工审查页：把成片、各画幅封面、发布元数据放到同一屏。
     自包含、无外部资源，和成片放在同一个 output/ 目录下双击即开；
     视频与封面都用相对文件名引用，所以整包挪动目录后依然可用。

     布局两条铁律：
     1) 高度一致 —— 每一行内的卡片拉伸到同一高度，媒体画面顶边/底边对齐；
     2) 宽度按比例分配 —— 列宽不平均分，flex-grow ∝ 素材宽高比，
        横版 16:9 分宽列、竖版 9:16 分窄列，画面高度便天然相等。 */
  :root {
    --bg: #0a1523;
    --panel: #101f33;
    --line: rgba(120, 170, 215, .22);
    --text: #eaf2fb;
    --muted: #8ea9c4;
    --accent: #69b7ff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    background: var(--bg); color: var(--text); padding: 34px 28px 60px;
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  .wrap { max-width: 1320px; margin: 0 auto; }
  h1 { font-size: 26px; font-weight: 700; letter-spacing: .01em; }
  h1 span { color: var(--accent); font-size: 17px; font-weight: 600; letter-spacing: .1em; margin-left: 10px; }
  .meta { margin-top: 10px; color: var(--muted); font-size: 13px; line-height: 1.9; }
  .meta code { color: var(--text); background: rgba(105, 183, 255, .10); border-radius: 5px; padding: 1px 7px; }
  h2 {
    margin: 34px 0 14px; font-size: 14px; font-weight: 600;
    letter-spacing: .18em; color: var(--accent);
  }
  /* 一行 = 一组等高卡片。flex-grow 由模板按素材宽高比内联写入。 */
  .row { display: flex; gap: 18px; align-items: stretch; flex-wrap: wrap; }
  .row > * { min-width: 240px; }
  figure, .panel {
    background: var(--panel); border: 1px solid var(--line); border-radius: 12px;
    padding: 12px; display: flex; flex-direction: column;
  }
  video, img { width: 100%; border-radius: 8px; display: block; background: #000; }
  figcaption { margin-top: auto; padding-top: 10px; font-size: 13px; line-height: 1.75; color: var(--muted); word-break: break-all; }
  figcaption b { display: block; color: var(--text); font-weight: 600; margin-bottom: 2px; }
  figcaption .tagline { color: var(--accent); }
  .panel { padding: 16px 18px; font-size: 14px; line-height: 1.95; }
  .panel h3 { font-size: 13px; font-weight: 600; letter-spacing: .14em; color: var(--accent); margin-bottom: 10px; }
  .panel .k { color: var(--muted); display: inline-block; min-width: 62px; }
  .panel ul { margin: 4px 0 0 76px; padding-left: 18px; }
  .panel li { margin: 2px 0; }
  table { border-collapse: collapse; font-size: 13px; width: 100%; }
  th, td { border: 1px solid var(--line); padding: 6px 14px; text-align: left; }
  /* 这一章一条口播数字都没取到：不该长得跟正常的一样 */
  tr.warn td { background: rgba(255, 176, 66, .10); }
  th { color: var(--muted); font-weight: 500; }
  td.ratio { color: var(--accent); }
</style>
</head>
<body>
<div class="wrap">

  <header>
    <h1>{{ stock_name }}<span>{{ stock_code }}</span></h1>
    <div class="meta">
      生成 {{ created_at }} · 辩论 {{ turns }} 轮 · 预计时长 {{ duration }} 秒 · 标签 <code>{{ tag }}</code><br>
      本页由生成流程自动产出，用于发布前审查画面、封面与文案；确认无误后再 <code>tangulunjin --publish-only {{ video_tag }}.mp4</code> 发布。
    </div>
  </header>

  <h2>成片</h2>
  <div class="row">
  {% for video in videos %}
    <figure style="flex: {{ video.aspect }} 1 0;">
      <video controls preload="metadata" src="{{ video.file }}" style="aspect-ratio: {{ video.aspect }};"></video>
      <figcaption>
        <b>{{ video.label }}</b>
        {{ video.file }}{% if video.platforms %}<br><span class="tagline">用于 {{ video.platforms }}</span>{% endif %}
      </figcaption>
    </figure>
  {% endfor %}
  </div>

  {% if covers %}
  <h2>封面图（信息流缩略图）</h2>
  <div class="row">
  {% for cover in covers %}
    <figure style="flex: {{ cover.aspect }} 1 0;">
      <img src="{{ cover.file }}" alt="{{ cover.label }}" style="aspect-ratio: {{ cover.aspect }};">
      <figcaption>
        <b>{{ cover.label }} · {{ cover.size }}</b>
        {{ cover.file }}{% if cover.platforms %}<br><span class="tagline">用于 {{ cover.platforms }}</span>{% endif %}
      </figcaption>
    </figure>
  {% endfor %}
  </div>
  {% endif %}

  {% if episode_plan and episode_plan.rounds %}
  <h2>本期叙事统筹（讲了什么、配了哪张图）</h2>
  <div class="row">
    <div class="panel" style="flex: 2 1 0;">
      <h3>选题与数字额度</h3>
      <div><span class="k">主线</span>{{ episode_plan.story.angle or "—" }}</div>
      <div><span class="k">底牌素材</span>{{ episode_plan.story.reveal_material_id or "—" }}</div>
      {% set nb_used = episode_plan.number_budget.used or {} %}
      {% set nb_cap = episode_plan.number_budget.cap or {} %}
      <div><span class="k">口播数字</span>anchor {{ nb_used.anchor or 0 }} / {{ nb_cap.anchor or 0 }} · analogy {{ nb_used.analogy or 0 }} / {{ nb_cap.analogy or 0 }}（按解释单元计，visual_only 不限）</div>
      {% if episode_plan.warnings %}
      {# warnings 混了两种语义：缺来源归缺来源，取不到口播数字归无数字可讲——
         顶着「缺来源…（已跳过，未补猜）」说另一种事等于在审查页上说错话。 #}
      {% set buckets = namespace(missing=[], exhausted=[], nosource=[]) %}
      {% for item in episode_plan.warnings %}
        {% if item.endswith(':missing_source') %}
          {% set buckets.missing = buckets.missing + [item] %}
        {% elif item.endswith('spoken_metrics_exhausted') %}
          {% set buckets.exhausted = buckets.exhausted + [item.split(':')[0]] %}
        {% elif item.endswith('no_spoken_metric_source') %}
          {% set buckets.nosource = buckets.nosource + [item.split(':')[0]] %}
        {% else %}
          {% set buckets.missing = buckets.missing + [item] %}
        {% endif %}
      {% endfor %}
      {% if buckets.missing %}
      <div><span class="k">缺来源</span>{{ buckets.missing|join('、') }}（已跳过，未补猜）</div>
      {% endif %}
      {% if buckets.nosource %}
      <div><span class="k">无数字可讲</span>{{ buckets.nosource|join('、') }}（素材没给可念的指标，要去补素材）</div>
      {% endif %}
      {% if buckets.exhausted %}
      <div><span class="k">无数字可讲</span>{{ buckets.exhausted|join('、') }}（可念的指标被前面的章节取完了，要调章节分配）</div>
      {% endif %}
      {% endif %}
      {% if episode_plan.rejected_materials %}
      <div><span class="k">已拒绝</span>{% for item in episode_plan.rejected_materials %}{{ item.id }}（{{ item.reason }}）{% if not loop.last %}、{% endif %}{% endfor %}</div>
      {% endif %}
    </div>
    <div class="panel" style="flex: 3 1 0;">
      <h3>五章与图板</h3>
      <table>
        <tr><th>章节</th><th>目的</th><th>领讲</th><th>素材</th><th>口播数字</th><th>图板</th><th>后退</th></tr>
        {% for chapter in episode_plan.rounds %}
        {% set nb = chapter.get('number_budget') %}
        {% set flagged = chapter.get('no_spoken_metric') %}
        <tr{% if flagged %} class="warn"{% endif %}>
          <td>{{ chapter.id }}</td>
          <td>{{ chapter.purpose }}</td>
          <td>{{ chapter.lead or "—" }}</td>
          <td>{{ chapter.material_ids|join('、') or "—" }}</td>
          <td>{% if flagged %}<b>无数字可讲</b>{% elif nb %}{{ (nb.anchor or 0) + (nb.analogy or 0) }} / {{ nb.spoken or 0 }}{% else %}—{% endif %}</td>
          <td class="ratio">{{ chapter.visual.template }}{% if chapter.visual.id %}<br><span class="tagline">{{ chapter.visual.id }}</span>{% endif %}</td>
          <td>{{ chapter.visual.fallback|join(' → ') }}</td>
        </tr>
        {% endfor %}
      </table>
    </div>
  </div>
  {% endif %}

  {% if arc or cta.hook or cta.question or cta.bull or cta.bear or arc_notes or message %}
  <h2>本期结构与互动</h2>
  <div class="row">
    <div class="panel" style="flex: 2 1 0;">
      <h3>剧本骨架</h3>
      {% if arc %}
      <div><span class="k">骨架</span>{{ arc.name or arc.id }}{% if arc.forced %}（配置强制指定）{% endif %}</div>
      <div><span class="k">节拍</span>{{ arc.beats|join(' → ') }}</div>
      {% if arc.pruned %}<div><span class="k">剪掉</span>{{ arc.pruned|join('、') }}（这只票没有对应数据）</div>{% endif %}
      {% if arc.eligible %}<div><span class="k">候选</span>{{ arc.eligible|join('、') }}</div>{% endif %}
      {% else %}
      <div><span class="k">骨架</span>—（脚本未记录，可能是旧版生成结果）</div>
      {% endif %}
      {% if arc_notes %}
      <div><span class="k">偏差</span>模型有 {{ arc_notes|length }} 处没完全照骨架走：</div>
      <ul>{% for note in arc_notes %}<li>{{ note }}</li>{% endfor %}</ul>
      {% endif %}
      {% if message %}
      {# 本期提示词（-m / dialogue.message）：这期"为什么讲得跟别期不一样"的原话。
         排版保留换行（pre-line），长提示词读起来仍是它写下的样子。 #}
      <div><span class="k">本期提示</span>操作者给 LLM 的选材参考：</div>
      <div style="white-space: pre-line; border-left: 2px solid var(--accent); padding: 2px 0 2px 10px;">{{ message }}</div>
      {% endif %}
    </div>
    <div class="panel" style="flex: 2 1 0;">
      <h3>片尾互动（会打在画面上）</h3>
      <div><span class="k">乐观一边</span>{{ cta.bull or "—" }}</div>
      <div><span class="k">谨慎一边</span>{{ cta.bear or "—" }}</div>
      <div><span class="k">下期盯</span>{{ cta.hook or "—" }}</div>
      <div><span class="k">提问</span>{{ cta.question or "—" }}</div>
    </div>
  </div>
  {% endif %}

  <h2>发布信息</h2>
  <div class="row">
  {% if canvas_rows %}
    <div class="panel" style="flex: 1 1 0;">
      <h3>平台画幅对应</h3>
      <table>
        <tr><th>平台</th><th>投放画幅</th></tr>
        {% for row in canvas_rows %}
        <tr><td>{{ row.label }}</td><td class="ratio">{{ row.canvas }}</td></tr>
        {% endfor %}
      </table>
    </div>
  {% endif %}
    <div class="panel" style="flex: 2 1 0;">
      <h3>发布文案</h3>
      <div><span class="k">标题</span>{{ title }}</div>
      <div><span class="k">简介</span>{{ description }}</div>
      <div><span class="k">话题</span>{{ tags }}</div>
    </div>
  {% if issues or disclaimers or rewrites %}
    <div class="panel" style="flex: 2 1 0;">
      <h3>合规自检</h3>
      {% if issues %}
      <div><span class="k">已拦截</span>共 {{ issues|length }} 条，改写后入片：</div>
      <ul>{% for issue in issues %}<li>{{ issue }}</li>{% endfor %}</ul>
      {% else %}
      <div><span class="k">已拦截</span>无</div>
      {% endif %}
      {% if rewrites %}
      <div><span class="k">改写对照</span>以下是逐字替换的结果，请确认语义没有被改跑：</div>
      <ul>{% for item in rewrites %}<li><b>{{ item.where }}</b><br>{{ item.before }}<br><span class="tagline">→ {{ item.after }}</span></li>{% endfor %}</ul>
      {% endif %}
      {% if disclaimers %}<div><span class="k">风险提示</span>{{ disclaimers }}</div>{% endif %}
    </div>
  {% endif %}
  </div>

</div>
</body>
</html>
