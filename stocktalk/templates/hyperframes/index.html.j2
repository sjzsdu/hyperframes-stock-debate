<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}"><head><meta charset="UTF-8"><meta name="viewport" content="width=1920,height=1080"><title>{{ name }} · 股会说</title><link rel="stylesheet" href="stock-debate.css"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script></head>
<body><main id="root" data-composition-id="stock-debate" data-start="0" data-width="1920" data-height="1080" data-duration="{{ duration }}" data-fps="30">
  <div class="grid clip" data-start="0" data-duration="{{ duration }}" data-track-index="0"></div>
  <header id="headline" class="clip" data-start="0" data-duration="{{ duration }}" data-track-index="1"><span>股会说 · 财报观点碰撞</span><h1>{{ name }} <em>{{ code }}</em></h1><p>最新价 {{ price }}　涨跌幅 {{ change }}</p></header>
  <aside class="roles">{% for role in roles %}<section id="role-{{ role.key }}" class="role panel {{ role.key }}" data-role="{{ role.key }}"><div class="avatar">{{ role.avatar }}</div><div><strong>{{ role.name }} <b>{{ role.stance }}</b></strong><p>{{ role.bio }}</p></div></section>{% endfor %}</aside>
  <section id="finance-card" class="panel finance clip" data-start="0.4" data-duration="{{ duration - 0.4 if duration > 0.4 else 0.1 }}" data-track-index="3"><h2>财报数据摘要</h2>{% for metric in financials %}<div class="metric"><span>{{ metric.label }}</span><strong>{{ metric.value }}</strong></div>{% endfor %}</section>
  <section id="kline-chart" class="panel chart clip" data-start="0.7" data-duration="{{ duration - 0.7 if duration > 0.7 else 0.1 }}" data-track-index="4"><h2>K线 · 均线 · 成交节奏</h2>{{ chart|safe }}</section>
  {% for segment in segments %}<section id="speech-{{ loop.index }}" class="speech panel clip {{ segment.character }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="10" data-speaker="{{ segment.character }}"><div class="speaker">{{ '看空方' if segment.character == 'bear' else '看多方' }}</div><p class="type-text" data-text="{{ segment.line }}"></p></section><section id="visual-{{ loop.index }}" class="visual-card panel clip {{ segment.topic }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="11" data-topic="{{ segment.topic }}"><small>谈什么 · SHOW 什么</small><h2>{{ segment.topic_title }}</h2><div class="visual-icon">{% if segment.topic == 'risk' %}⚠{% elif segment.topic == 'valuation' %}PE{% elif segment.topic == 'comparison' %}↔{% elif segment.topic == 'sentiment' %}◔{% else %}▟{% endif %}</div><p>{{ segment.visual_prompt }}</p></section>{% endfor %}
  <section id="summary-card" class="summary panel clip" data-start="{{ duration - 1.5 if duration > 1.5 else 0 }}" data-duration="1.5" data-track-index="20"><small>观点碰撞总结</small><h2>增长、估值与风险，交给数据继续验证</h2></section>
  {% for segment in segments if segment.audio_path %}<audio id="audio-{{ loop.index }}" src="{{ segment.audio_path }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="{{ 100 + loop.index }}"></audio>{% endfor %}
  <footer class="clip disclaimer" data-start="0" data-duration="{{ duration }}" data-track-index="30">内容仅为虚拟人物观点交流，不构成任何投资建议；市场有风险，决策需谨慎。</footer>
</main><script>window.__timelines=window.__timelines||{};window.__timelines["stock-debate"]=null;</script><script src="stock-debate.js"></script></body></html>
