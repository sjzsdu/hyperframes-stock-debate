<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1920,height=1080">
  <title>{{ name }}</title>
  <link rel="stylesheet" href="stock-debate.css">
  <script src="gsap.min.js"></script>
</head>
<body>
<main id="root" data-composition-id="stock-debate" data-start="0" data-width="1920" data-height="1080" data-duration="{{ duration }}" data-fps="30">
{% set outro_start = duration - 0.45 %}
  <div id="ambient-orb-a" class="ambient-orb orb-a clip" data-start="0" data-duration="{{ duration }}" data-track-index="1" data-layout-ignore></div>
  <div id="ambient-orb-b" class="ambient-orb orb-b clip" data-start="0" data-duration="{{ duration }}" data-track-index="2" data-layout-ignore></div>

  <header id="headline" class="clip" data-start="0" data-duration="{{ outro_start }}" data-track-index="3">
    <div class="title-row"><h1>{{ name }} <em>{{ code }}</em></h1></div>
    <p class="{{ price_tone }}">{{ price_line }}</p>
  </header>

  <section id="market-stage" class="clip" data-start="0.35" data-duration="{{ outro_start - 0.35 if outro_start > 0.35 else 0.1 }}" data-track-index="4">
    <section id="kline-chart" class="panel chart">
      <div class="chart-camera">{{ chart|safe }}</div>
    </section>
    <section id="finance-card" class="panel finance">
      <div class="metric-list">{% for metric in financials %}<div class="metric"><span>{{ metric.label }}</span><strong class="{{ metric.tone or '' }}">{{ metric.value }}</strong></div>{% endfor %}</div>
    </section>
  </section>

  {% for segment in segments %}
  <section id="slide-{{ loop.index }}" class="slide {{ segment.character }} {{ segment.topic }} clip {{ 'slide-cover' if segment.is_first else '' }}" data-start="{{ segment.visual_start }}" data-duration="{{ segment.visual_duration }}" data-track-index="{{ 50 + loop.index }}" data-topic="{{ segment.topic }}" {% if segment.is_first %}data-cover-slide{% endif %}>
    <div class="slide-kicker">{{ segment.topic_title }}</div>
    <div class="slide-keywords">{% for keyword in segment.keywords %}<span>{{ keyword }}</span>{% endfor %}</div>
    <div class="slide-visual">{{ segment.visual|safe }}</div>
    <section id="speech-{{ loop.index }}" class="speech panel" data-layout-allow-caption-zone>
      <p class="type-text">{{ segment.line }}</p>
      <div class="speech-progress" data-layout-ignore><i></i></div>
    </section>
  </section>
  {% endfor %}

  {# Natural opening: the intro card rides in over the headline + real chart, then fades into the first slide #}
  <section id="intro-card" class="intro-card clip" data-start="0" data-duration="2.4" data-track-index="40" data-layout-ignore>
    <div class="intro-kicker">聊公司</div>
    <div class="intro-title">{{ name }} <em>{{ code }}</em></div>
    <div class="intro-svg">{{ intro_svg|safe }}</div>
  </section>

  {# Natural closing: recap card with the real interval numbers, fading over the last slide #}
  <section id="outro-card" class="outro-card clip" data-start="{{ outro_start }}" data-duration="0.45" data-track-index="60" data-layout-ignore>
    <div class="outro-kicker">今天聊到这</div>
    <div class="outro-title">{{ outro_title }}</div>
    <div class="outro-svg">{{ outro_svg|safe }}</div>
    <div class="outro-tip">{{ outro_tip }}</div>
  </section>

  {% for segment in segments if segment.audio_path %}
  <audio id="audio-{{ loop.index }}" src="{{ segment.audio_path }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="{{ 120 + loop.index }}" data-audio-group="dialogue" data-volume="0.94" data-fx-chain="{{ segment.fx_chain|e }}" data-automation="{{ segment.audio_automation|e }}"></audio>
  {% endfor %}
</main>
<script>window.__timelines=window.__timelines||{};</script>
<script src="stock-debate.js"></script>
</body>
</html>
