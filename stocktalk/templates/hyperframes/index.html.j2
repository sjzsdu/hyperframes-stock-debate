<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}"><head><meta charset="UTF-8"><meta name="viewport" content="width=1920,height=1080"><title>{{ name }} · 股会说</title><link rel="stylesheet" href="stock-debate.css"><script src="gsap.min.js"></script></head>
<body><main id="root" data-composition-id="stock-debate" data-start="0" data-width="1920" data-height="1080" data-duration="{{ duration }}" data-fps="30">
  <div id="background-grid" class="grid clip" data-start="0" data-duration="{{ duration }}" data-track-index="0"></div>
  <header id="headline" class="clip" data-start="0" data-duration="{{ duration }}" data-track-index="1"><span>股会说 · 一起聊公司</span><h1>{{ name }} <em>{{ code }}</em></h1><p>{{ price_line }}</p></header>
  <section id="finance-card" class="panel finance clip" data-start="0.4" data-duration="{{ duration - 0.4 if duration > 0.4 else 0.1 }}" data-track-index="3"><h2>行情与数据</h2>{% for metric in financials %}<div class="metric"><span>{{ metric.label }}</span><strong>{{ metric.value }}</strong></div>{% endfor %}</section>
  <section id="kline-chart" class="panel chart clip" data-start="0.7" data-duration="{{ duration - 0.7 if duration > 0.7 else 0.1 }}" data-track-index="4"><h2>价格走势</h2>{{ chart|safe }}</section>
  {% for segment in segments %}<section id="speech-{{ loop.index }}" class="speech panel clip" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="10"><small>正在讨论 · {{ segment.topic_title }}</small><p class="type-text">{{ segment.line }}</p></section><section id="visual-{{ loop.index }}" class="visual-card panel clip {{ segment.topic }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="11" data-topic="{{ segment.topic }}"><h2>{{ segment.topic_title }}</h2><div class="topic-chart">{{ segment.visual|safe }}</div></section>{% endfor %}
  {% for segment in segments if segment.audio_path %}<audio id="audio-{{ loop.index }}" src="{{ segment.audio_path }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="{{ 100 + loop.index }}"></audio>{% endfor %}
</main><script>window.__timelines=window.__timelines||{};</script><script src="stock-debate.js"></script></body></html>
