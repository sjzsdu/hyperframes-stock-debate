<!doctype html>
<html lang="zh-CN" data-theme="{{ theme }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width={{ canvas_width }},height={{ canvas_height }}">
  <title>{{ name }}</title>
  <link rel="stylesheet" href="stock-debate.css">
  <script src="gsap.min.js"></script>
</head>
<body>
{# One permanent stage.  The headline, the panel frame and the caption box never
   move; only the four content slots below change, and only when their content
   actually differs from the previous turn (see HyperFramesBuilder._merge_slot). #}
<main id="root" class="layout-{{ layout }} captions-{{ subtitle_mode }}" data-composition-id="stock-debate" data-start="0" data-width="{{ canvas_width }}" data-height="{{ canvas_height }}" data-duration="{{ duration }}" data-stage-in="{{ stage_in }}" data-fps="30" style="--safe-top: {{ safe_top }}px; --safe-bottom: {{ safe_bottom }}px; --safe-side: {{ safe_side }}px;">
{% set outro_start = duration - 0.45 %}
  {# Safe-area guides: the bands the platform's player UI will sit on.  Hidden
     unless the preview URL asks for them (#guides), so they can never reach a
     rendered MP4. #}
  <div id="safe-guides" class="safe-guides" aria-hidden="true"><i class="safe-top"></i><i class="safe-bottom"></i></div>
  <div id="ambient-orb-a" class="ambient-orb orb-a clip" data-start="0" data-duration="{{ duration }}" data-track-index="1" data-layout-ignore></div>
  <div id="ambient-orb-b" class="ambient-orb orb-b clip" data-start="0" data-duration="{{ duration }}" data-track-index="2" data-layout-ignore></div>

  {# Slot 0 — speaker ambience.  A run of turns by the same speaker is one
     layer, so the backdrop only changes when the speaker actually changes. #}
  {% for item in slots.tint %}
  <div class="stage-tint {{ item.character }} clip" data-start="{{ item.start }}" data-duration="{{ item.duration }}" data-track-index="5" data-slot="tint" data-layout-ignore></div>
  {% endfor %}

  {# Permanent: stock name, code and the real quote #}
  <header id="headline" class="clip" data-start="0" data-duration="{{ outro_start }}" data-track-index="3" data-layout-ignore>
    <div class="title-row"><h1>{{ name }} <em>{{ code }}</em></h1></div>
    <p class="{{ price_tone }}">{{ price_line }}</p>
  </header>

  {# Slot 1 — topic label #}
  {% for item in slots.kicker %}
  <div class="slot-kicker {{ item.character }} clip" data-start="{{ item.start }}" data-duration="{{ item.duration }}" data-track-index="10" data-slot="kicker" data-topic="{{ item.topic }}" data-layout-ignore>{{ item.text }}</div>
  {% endfor %}

  {# Slot 2 — talking-point chips #}
  {% for item in slots.keywords %}
  <div class="slot-keywords {{ item.character }} clip" data-start="{{ item.start }}" data-duration="{{ item.duration }}" data-track-index="11" data-slot="keywords" data-layout-ignore>{% for keyword in item.keywords %}<span>{{ keyword }}</span>{% endfor %}</div>
  {% endfor %}

  {# Permanent: the panel frame.  Contents swap inside it, the frame itself
     never moves, so a turn change never shifts the surrounding layout. #}
  <div id="visual-frame" class="clip" data-start="0" data-duration="{{ outro_start }}" data-track-index="4" data-layout-ignore></div>

  {# Slot 3 — the panel contents (real market data, then one board per turn) #}
  {% for item in slots.visual %}
  {% if item.kind == 'market' %}
  <div class="visual-item visual-market clip" data-start="{{ item.start }}" data-duration="{{ item.duration }}" data-track-index="{{ 20 + loop.index }}" data-slot="visual" data-layout-ignore>
    <div class="market-chart"><div class="chart-camera">{{ chart|safe }}</div></div>
    <div class="market-finance"><div class="metric-list">{% for metric in financials %}<div class="metric"><span>{{ metric.label }}</span><strong class="{{ metric.tone or '' }}">{{ metric.value }}</strong></div>{% endfor %}</div></div>
  </div>
  {% else %}
  <div class="visual-item clip" data-start="{{ item.start }}" data-duration="{{ item.duration }}" data-track-index="{{ 20 + loop.index }}" data-slot="visual" data-layout-ignore>{{ item.svg|safe }}</div>
  {% endif %}
  {% endfor %}

  {# Permanent: single-row caption box #}
  {% if subtitles %}
  <section id="caption-zone" class="clip" data-start="0" data-duration="{{ outro_start }}" data-track-index="30" data-layout-allow-caption-zone>
    {% for caption in slots.caption %}
    <p class="caption-line {{ caption.character }}" data-start="{{ caption.start }}" data-duration="{{ caption.duration }}" data-slot="caption" data-layout-ignore>{{ caption.text }}</p>
    {% endfor %}
    {% for bar in slots.progress %}<i class="progress-fill" data-start="{{ bar.start }}" data-duration="{{ bar.duration }}" data-layout-ignore></i>{% endfor %}
  </section>
  {% endif %}

  {# Natural opening: the title card takes over the panel area, then dissolves
     to reveal the real market data that was already standing behind it. #}
  <section id="intro-card" class="intro-card clip" data-start="0" data-duration="{{ stage_in + 1.5 }}" data-track-index="40" data-layout-ignore>
    <div class="intro-kicker">聊公司</div>
    <div class="intro-title">{{ name }} <em>{{ code }}</em></div>
  </section>

  {# Natural closing: recap card with the real interval numbers #}
  <section id="outro-card" class="outro-card clip" data-start="{{ outro_start }}" data-duration="0.45" data-track-index="60" data-layout-ignore>
    <div class="outro-kicker">今天聊到这</div>
    <div class="outro-title">{{ outro_title }}</div>
    <div class="outro-svg">{{ outro_svg|safe }}</div>
    <div class="outro-tip">{{ outro_tip }}</div>
  </section>

  {% for segment in segments if segment.audio_path %}
  <audio id="audio-{{ loop.index }}" src="{{ segment.audio_path }}" data-start="{{ segment.start }}" data-duration="{{ segment.duration }}" data-track-index="{{ 120 + loop.index }}" data-audio-group="dialogue" data-volume="0.94" data-fx-chain="{{ segment.fx_chain|e }}" data-automation="{{ segment.audio_automation|e }}"></audio>
  {% endfor %}
</main>
<script>window.__timelines=window.__timelines||{};</script>
<script src="stock-debate.js"></script>
</body>
</html>
