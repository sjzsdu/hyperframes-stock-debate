<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ name }} {{ code }}</title>
<style>
  /* Self-contained: the file is opened directly by Chrome, so the palette and
     the A股 红涨绿跌 convention live here rather than in stock-debate.css.
     All type is sized with min(vw, vh) so one template covers 3:4, 4:3 and
     16:9 without a per-ratio stylesheet. */
  :root {
    --bg: #050b16;
    --panel: rgba(11, 26, 46, .92);
    --text: #f5f8ff;
    --muted: #91a8bf;
    --line: rgba(101, 151, 196, .30);
    --accent: #69b7ff;
    --gold: #ffd166;
    --up: #ff7188;
    --down: #5ee0a7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #cover {
    position: relative;
    width: 100vw; height: 100vh;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-areas: "brand" "ident" "quote" "chart" "hook" "tags";
    grid-template-rows: auto auto auto minmax(0, 1fr) auto auto;
    row-gap: 2.6vh;
    padding: 6vh 6.6vw;
    background: radial-gradient(circle at 24% 10%, #17395c 0, #0a1a2c 44%, var(--bg) 78%);
  }
  .glow { position: absolute; border-radius: 50%; filter: blur(9vh); opacity: .17; z-index: -1; }
  .glow-a { left: -14vw; top: 8vh; width: 52vw; height: 52vw; background: #ff78bc; }
  .glow-b { right: -16vw; top: -10vh; width: 46vw; height: 46vw; background: #65baff; }

  .brand { grid-area: brand; display: flex; align-items: baseline; gap: 1.4vw; }
  .brand .mark {
    font-size: min(2.5vw, 1.9vh); font-weight: 700; letter-spacing: .26em;
    color: var(--text); padding: .55vh 1.3vw;
    border: 1px solid var(--line); border-radius: 999px;
    background: linear-gradient(135deg, rgba(105,183,255,.20), rgba(105,183,255,.04));
  }
  .brand .sub { font-size: min(1.6vw, 1.25vh); color: var(--muted); letter-spacing: .1em; }

  .ident { grid-area: ident; display: flex; align-items: flex-end; gap: 1.4vw; flex-wrap: wrap; }
  .ident h1 {
    font-size: min(9.2vw, 6.4vh); line-height: 1.02; letter-spacing: -.01em;
    text-shadow: 0 1.2vh 4vh rgba(0,0,0,.55);
  }
  .ident .code {
    font-size: min(3.4vw, 2.4vh); font-weight: 600; color: var(--accent);
    letter-spacing: .14em; padding-bottom: 1.4vh; font-variant-numeric: tabular-nums;
  }

  .quote { grid-area: quote; display: flex; align-items: baseline; gap: 1.8vw; flex-wrap: wrap; }
  .quote .price {
    font-size: min(6.4vw, 4.5vh); font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .quote .change {
    font-size: min(3.6vw, 2.6vh); font-weight: 700; font-variant-numeric: tabular-nums;
    padding: .5vh 1.2vw; border-radius: 10px;
  }
  .quote.up .price, .quote.up .change { color: var(--up); }
  .quote.down .price, .quote.down .change { color: var(--down); }
  .quote.up .change { background: rgba(255,113,136,.14); }
  .quote.down .change { background: rgba(94,224,167,.14); }
  .quote.flat .change { color: var(--muted); background: rgba(145,168,191,.12); }
  .quote .meta {
    display: flex; gap: 1.6vw; font-size: min(1.9vw, 1.4vh); color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .quote .meta b { color: var(--text); font-weight: 600; margin-left: .5vw; }

  .chart {
    grid-area: chart; position: relative; min-height: 0; overflow: hidden;
    background: linear-gradient(150deg, rgba(17,38,64,.95), var(--panel));
    border: 1px solid var(--line); border-radius: 2.2vh;
    box-shadow: 0 3vh 8vh rgba(0,0,0,.42), inset 0 1px 0 rgba(255,255,255,.04);
    padding: 2.6vh 2.4vw 1.4vh;
    display: flex; flex-direction: column;
  }
  .chart .chart-head {
    display: flex; justify-content: space-between; align-items: center;
    font-size: min(1.7vw, 1.3vh); color: var(--muted); letter-spacing: .08em;
  }
  .chart .chart-head b { color: var(--text); font-weight: 600; }
  .chart .chart-body { flex: 1; min-height: 0; padding-top: 1.2vh; }
  .chart svg { width: 100%; height: 100%; display: block; }
  .chart .spark-fill { opacity: .9; }  .chart .spark-line { fill: none; stroke-width: 3.2; vector-effect: non-scaling-stroke; }
  .chart.up { color: var(--up); }
  .chart.down { color: var(--down); }
  .chart.flat { color: var(--accent); }
  .chart.up .spark-line { stroke: var(--up); }
  .chart.down .spark-line { stroke: var(--down); }
  .chart.flat .spark-line { stroke: var(--accent); }
  /* 渐变色走 currentColor：CSS 的 fill 规则会盖掉 path 上的 fill 属性，
     而 stop-color 不会被任何选择器覆盖。 */
  .chart .grid { stroke: rgba(101,151,196,.22); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .chart .cursor-rule { fill: var(--gold); opacity: .38; }
  .chart .cursor-dot { fill: var(--gold); }

  .hook { grid-area: hook; font-size: min(3.2vw, 2.25vh); line-height: 1.5; }
  .hook .kicker {
    display: block; font-size: min(1.7vw, 1.25vh); color: var(--accent);
    letter-spacing: .22em; margin-bottom: 1.1vh;
  }
  .hook .text { color: var(--text); }

  .tags { grid-area: tags; display: flex; gap: 1.1vw; flex-wrap: wrap; }
  .tags span {
    font-size: min(1.6vw, 1.2vh); color: var(--muted);
    border: 1px solid var(--line); border-radius: 999px;
    padding: .7vh 1.3vw; background: rgba(105,183,255,.05);
  }

  /* 横屏（4:3 与 16:9）：品牌/名称/行情挤到左上，图板占满右列。 */
  @media (min-aspect-ratio: 1/1) {
    #cover {
      grid-template-areas: "brand chart" "ident chart" "quote chart" "hook chart" "tags chart";
      grid-template-columns: 52fr 48fr;
      grid-template-rows: auto auto auto minmax(0, 1fr) auto;
      column-gap: 3.4vw;
      row-gap: 2.2vh;
      padding: 5.4vh 5.4vw;
    }
    .ident h1 { font-size: min(6.6vw, 7.4vh); }
    .quote .price { font-size: min(4.6vw, 5.2vh); }
    .hook { font-size: min(2.1vw, 2.4vh); }
    /* 横屏时左列剩余高度都落在看点行上，居中让它不顶在最上面留一大块空。 */
    .hook { align-self: center; }
  }
</style>
</head>
<body>
<main id="cover" data-ratio="{{ width }}x{{ height }}">
  <div class="glow glow-a"></div>
  <div class="glow glow-b"></div>

  <header class="brand">
    <span class="mark">谈股论金</span>
    <span class="sub">多空对话 · 只看生意与数据</span>
  </header>

  <div class="ident">
    <h1>{{ name }}</h1>
    <div class="code">{{ code }}</div>
  </div>

  <div class="quote {{ tone }}">
    <div class="price">{{ price_text }}</div>
    <div class="change">{{ change_text }}</div>
    <div class="meta">{% for item in meta_items %}<span>{{ item.label }}<b>{{ item.value }}</b></span>{% endfor %}</div>
  </div>

  <section class="chart {{ tone }}">
    <div class="chart-head">
      <span>{{ chart_title }}</span>
      <span>{% if chart_min %}<b>{{ chart_min }}</b> 最低　<b>{{ chart_max }}</b> 最高{% endif %}</span>
    </div>
    <div class="chart-body">{{ sparkline|safe }}</div>
  </section>

  <div class="hook">
    <span class="kicker">本期看点</span>
    <div class="text">{{ hook }}</div>
  </div>

  <div class="tags">{% for tag in tags %}<span>{{ tag }}</span>{% endfor %}</div>
</main>
</body>
</html>
