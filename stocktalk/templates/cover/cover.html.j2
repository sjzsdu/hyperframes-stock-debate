<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>{{ name }} {{ code }}</title>
<style>
  /* Self-contained: the file is opened directly by Chrome, so the palette and
     the A股 红涨绿跌 convention live here rather than in stock-debate.css.
     All type is sized with min(vw, vh) so one template covers 3:4, 4:3 and
     16:9 without a per-ratio stylesheet.

     设计原则（2026-09-20 改版）：封面在信息流里只有拇指大小，一切以缩略图
     可读性为准 —— 大名字、大涨幅、大钩子、无框大曲线；feed 里读不清的
     成交额/成交量/话题标签一律砍掉或弱化；技术信号词属于买卖信号，
     合规禁止上封面。 */
  :root {
    --bg: #060d18;
    --panel: rgba(11, 26, 46, .92);
    --text: #f5f8ff;
    --muted: #93aac2;
    --line: rgba(101, 151, 196, .30);
    --accent: #69b7ff;
    --up: #ff7188;
    --down: #5ee0a7;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { width: 100%; height: 100%; overflow: hidden; }
  body {
    background: var(--bg);
    color: var(--text);
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  #cover {
    position: relative;
    width: 100vw; height: 100vh;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    grid-template-areas: "brand" "hero" "chart" "hook" "tags";
    grid-template-rows: auto auto minmax(0, 1fr) auto auto;
    row-gap: 2.4vh;
    padding: 5vh 6.4vw 4.6vh;
    /* 背景氛围随涨跌变色：红涨绿跌在缩略图里第一眼可感知 */
    background:
      radial-gradient(circle at 78% 6%, var(--tint-a) 0, transparent 52%),
      radial-gradient(circle at 12% 88%, var(--tint-b) 0, transparent 46%),
      linear-gradient(160deg, #0b1a2c 0, var(--bg) 70%);
  }
  #cover.up   { --tint-a: rgba(255, 90, 120, .34); --tint-b: rgba(255, 113, 136, .16); }
  #cover.down { --tint-a: rgba(70, 230, 165, .26); --tint-b: rgba(94, 224, 167, .13); }
  #cover.flat { --tint-a: rgba(105, 183, 255, .26); --tint-b: rgba(105, 183, 255, .12); }
  /* 细网格纹理：给深底一点印刷质感 */
  #cover::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background:
      repeating-linear-gradient(0deg, rgba(148, 190, 230, .05) 0 1px, transparent 1px 9vh),
      repeating-linear-gradient(90deg, rgba(148, 190, 230, .05) 0 1px, transparent 1px 9vh);
    mask-image: radial-gradient(circle at 50% 42%, #000 30%, transparent 78%);
  }

  .brand { grid-area: brand; display: flex; align-items: baseline; gap: 1.3vw; }
  .brand .mark {
    font-size: min(2.3vw, 1.7vh); font-weight: 700; letter-spacing: .26em;
    color: var(--text); padding: .5vh 1.2vw;
    border: 1px solid var(--line); border-radius: 999px;
    background: linear-gradient(135deg, rgba(105,183,255,.20), rgba(105,183,255,.04));
  }
  .brand .sub { font-size: min(1.5vw, 1.15vh); color: var(--muted); letter-spacing: .12em; }

  .hero { grid-area: hero; }
  .hero .name-row { display: flex; align-items: baseline; gap: 1.6vw; flex-wrap: wrap; }
  .hero h1 {
    font-size: min(10.6vw, 7.6vh); line-height: 1.04; letter-spacing: -.01em;
    text-shadow: 0 1.4vh 4.5vh rgba(0,0,0,.6);
  }
  .hero .code {
    font-size: min(3.2vw, 2.3vh); font-weight: 600; color: var(--accent);
    letter-spacing: .14em; font-variant-numeric: tabular-nums;
  }
  .quote { display: flex; align-items: baseline; gap: 1.8vw; margin-top: 1.6vh; flex-wrap: wrap; }
  .quote .price {
    font-size: min(7.2vw, 5.1vh); font-weight: 700; font-variant-numeric: tabular-nums;
  }
  .quote .change {
    font-size: min(4.6vw, 3.3vh); font-weight: 800; font-variant-numeric: tabular-nums;
    padding: .6vh 1.4vw; border-radius: 12px;
  }
  .quote.up .price, .quote.up .change { color: var(--up); }
  .quote.down .price, .quote.down .change { color: var(--down); }
  .quote.up .change { background: rgba(255,113,136,.15); text-shadow: 0 0 3.4vh rgba(255,113,136,.65); }
  .quote.down .change { background: rgba(94,224,167,.15); text-shadow: 0 0 3.4vh rgba(94,224,167,.55); }
  .quote.flat .change { color: var(--muted); background: rgba(145,168,191,.12); text-shadow: none; }

  .chart {
    grid-area: chart; position: relative; min-height: 0;
    /* 无边框大曲线：海报背景的一部分，不再是「截图里的卡片」 */
    border-radius: 2.2vh;
    background: linear-gradient(180deg, rgba(13,30,52,.55), rgba(9,20,36,.28));
    padding: 2.2vh 2.2vw 1.2vh;
    display: flex; flex-direction: column;
  }
  .chart .chart-head {
    display: flex; justify-content: space-between; align-items: center;
    font-size: min(1.7vw, 1.3vh); color: var(--muted); letter-spacing: .1em;
  }
  .chart .chart-head b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
  .chart .chart-body { flex: 1; min-height: 0; padding-top: 1.4vh; position: relative; }
  .chart svg { width: 100%; height: 100%; display: block; }
  .chart .spark-fill { opacity: .85; }
  .chart .spark-line {
    fill: none; stroke-width: 4.6; vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 1.6vh currentColor);
  }
  .chart.up { color: var(--up); }
  .chart.down { color: var(--down); }
  .chart.flat { color: var(--accent); }
  .chart.up .spark-line { stroke: var(--up); }
  .chart.down .spark-line { stroke: var(--down); }
  .chart.flat .spark-line { stroke: var(--accent); }
  /* 渐变色走 currentColor：CSS 的 fill 规则会盖掉 path 上的 fill 属性，
     而 stop-color 不会被任何选择器覆盖。 */
  .chart .grid { stroke: rgba(101,151,196,.20); stroke-width: 1; vector-effect: non-scaling-stroke; }
  /* 末点光晕：绝对定位的 HTML 层，不受 SVG viewBox 拉伸影响（不会变椭圆） */
  .pulse {
    position: absolute; right: -0.6vw; top: 50%; transform: translateY(-50%);
    width: min(7vw, 5vh); aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, currentColor 0, rgba(255,255,255,.5) 12%, transparent 68%);
    opacity: .95; pointer-events: none;
  }

  .hook { grid-area: hook; }
  .hook .kicker {
    display: block; font-size: min(1.7vw, 1.25vh); color: var(--accent);
    letter-spacing: .24em; margin-bottom: 1.2vh;
  }
  .hook .text {
    font-size: min(4.6vw, 3.4vh); line-height: 1.42; font-weight: 600;
    color: var(--text); text-shadow: 0 1vh 3vh rgba(0,0,0,.55);
  }

  .tags { grid-area: tags; display: flex; gap: 1.1vw; flex-wrap: wrap; }
  .tags span {
    font-size: min(1.8vw, 1.35vh); color: var(--muted);
    border: 1px solid var(--line); border-radius: 999px;
    padding: .7vh 1.4vw; background: rgba(105,183,255,.05);
  }

  /* 横屏（4:3 与 16:9）：左列文字，右列曲线通高铺满。 */
  @media (min-aspect-ratio: 1/1) {
    #cover {
      grid-template-areas: "brand chart" "hero chart" "hook chart" "tags chart";
      grid-template-columns: 46fr 54fr;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      column-gap: 3.6vw;
      row-gap: 2.6vh;
      padding: 5.6vh 5.4vw;
    }
    .hero h1 { font-size: min(6.4vw, 7.6vh); }
    .quote .price { font-size: min(4.4vw, 5.4vh); }
    .quote .change { font-size: min(2.9vw, 3.6vh); }
    .hook { align-self: end; padding-bottom: 1vh; }
    .hook .text { font-size: min(2.2vw, 2.9vh); }
    .chart .chart-body { padding-bottom: .6vh; }
  }
</style>
</head>
<body>
<main id="cover" class="{{ tone }}" data-ratio="{{ width }}x{{ height }}">

  <header class="brand">
    <span class="mark">谈股论金</span>
    <span class="sub">多空对话 · 只看生意与数据</span>
  </header>

  <section class="hero">
    <div class="name-row">
      <h1>{{ name }}</h1>
      <span class="code">{{ code }}</span>
    </div>
    <div class="quote {{ tone }}">
      <span class="price">{{ price_text }}</span>
      <span class="change">{{ change_text }}</span>
    </div>
  </section>

  <section class="chart {{ tone }}">
    <div class="chart-head">
      <span>{{ chart_title }}</span>
      <span>{% if chart_min %}<b>{{ chart_min }}</b> 低　<b>{{ chart_max }}</b> 高{% endif %}</span>
    </div>
    <div class="chart-body">
      {{ sparkline|safe }}{% if spark_end_y is not none %}<i class="pulse" style="top: {{ spark_end_y }}%"></i>{% endif %}
    </div>
  </section>

  <div class="hook">
    <span class="kicker">本期看点</span>
    <div class="text">{{ hook }}</div>
  </div>

  <div class="tags">{% for tag in tags %}<span>{{ tag }}</span>{% endfor %}</div>
</main>
</body>
</html>
